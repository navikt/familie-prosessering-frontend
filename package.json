{
  "name": "familie-prosessering",
  "version": "0.0.1",
  "packageManager": "pnpm@11.15.0",
  "type": "module",
  "main": "dist_backend/server.js",
  "repository": "https://github.com/navikt/familie-prosessering.git",
  "author": "Team BAKS",
  "license": "MIT",
  "scripts": {
    "start": "NODE_ENV=production ENV=prod node dist_backend/server.js",
    "start:dev": "pnpm build:backend && NODE_ENV=development node dist_backend/server.js",
    "build": "pnpm build:prod",
    "build:prod": "NODE_ENV=production pnpm build:backend && pnpm build:frontend",
    "build:backend": "tsc -p src/backend/tsconfig.json && node scripts/prune-backend-node-modules.js",
    "build:frontend": "vite build src/frontend",
    "test": "echo \"No test specified.\"",
    "prepare": "husky",
    "typecheck": "tsc --noEmit -p src/backend/tsconfig.json && tsc --noEmit -p src/frontend/tsconfig.json",
    "lint": "eslint './src/**/*.{js,ts,tsx}'",
    "lint:fix": "eslint './src/**/*.{js,ts,tsx}' --fix",
    "validate": "pnpm typecheck && pnpm lint"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix --max-warnings=0"
    ]
  },
  "dependencies": {
    "@nais/apm": "0.6.0",
    "@navikt/aksel-icons": "8.11.0",
    "@navikt/ds-css": "8.11.0",
    "@navikt/ds-react": "8.11.0",
    "@navikt/ds-tokens": "8.11.0",
    "@navikt/familie-backend": "10.1.24",
    "@navikt/familie-logging": "7.0.7",
    "@navikt/familie-typer": "8.0.5",
    "autoprefixer": "10.5.0",
    "axios": "1.16.1",
    "classnames": "2.5.1",
    "constate": "4.0.0",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "http-proxy-middleware": "4.0.0",
    "loglevel": "1.9.2",
    "moment": "2.30.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router": "8.3.0",
    "react-router-dom": "7.16.0",
    "tslib": "2.8.1",
    "uuid": "14.0.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.4.0",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@types/react-router-dom": "5.3.3",
    "@vercel/nft": "1.10.2",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "9.1.7",
    "less": "4.6.4",
    "lint-staged": "17.0.5",
    "prettier": "3.8.3",
    "typescript": "7.0.2",
    "typescript-eslint": "8.60.0",
    "vite": "8.2.1"
  }
}

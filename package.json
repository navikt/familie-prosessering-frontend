{
  "name": "familie-prosessering",
  "version": "0.0.1",
  "packageManager": "pnpm@11.15.0",
  "type": "module",
  "main": "dist_backend/server.js",
  "repository": "https://github.com/navikt/familie-prosessering.git",
  "author": "Team BAKS",
  "license": "MIT",
  "scripts": {
    "start": "NODE_ENV=production ENV=prod node dist_backend/server.js",
    "start:dev": "pnpm build:backend && NODE_ENV=development node dist_backend/server.js",
    "build": "pnpm build:prod",
    "build:prod": "NODE_ENV=production pnpm build:backend && pnpm build:frontend",
    "build:backend": "tsc -p src/backend/tsconfig.json && node scripts/prune-backend-node-modules.js",
    "build:frontend": "vite build src/frontend",
    "test": "echo \"No test specified.\"",
    "prepare": "husky",
    "typecheck": "tsc --noEmit -p src/backend/tsconfig.json && tsc --noEmit -p src/frontend/tsconfig.json",
    "lint": "biome check ./src",
    "lint:fix": "biome check --write ./src",
    "validate": "pnpm typecheck && pnpm lint"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "biome check --write --error-on-warnings"
    ]
  },
  "dependencies": {
    "@nais/apm": "0.6.0",
    "@navikt/aksel-icons": "8.11.0",
    "@navikt/ds-css": "8.11.0",
    "@navikt/ds-react": "8.11.0",
    "@navikt/ds-tokens": "8.11.0",
    "@navikt/familie-backend": "10.1.24",
    "@navikt/familie-logging": "7.0.7",
    "@navikt/familie-typer": "8.0.5",
    "autoprefixer": "10.5.0",
    "axios": "1.16.1",
    "classnames": "2.5.1",
    "constate": "3.3.3",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "http-proxy-middleware": "4.0.0",
    "loglevel": "1.9.2",
    "moment": "2.30.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router": "7.16.0",
    "react-router-dom": "7.16.0",
    "tslib": "2.8.1",
    "uuid": "14.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/express": "5.0.6",
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@types/react-router-dom": "5.3.3",
    "@vercel/nft": "1.10.2",
    "@vitejs/plugin-react": "6.0.5",
    "husky": "9.1.7",
    "less": "4.6.4",
    "lint-staged": "17.0.5",
    "typescript": "6.0.3",
    "vite": "8.2.1"
  }
}
